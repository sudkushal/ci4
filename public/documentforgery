# -------------------------
# Security & IO
# -------------------------
class SecureIO:
    @staticmethod
    def validate_image_header(path: str) -> bool:
        """Checks magic bytes to ensure file is actually an image."""
        try:
            with open(path, "rb") as f:
                header = f.read(4)
            for magic, fmt in CONFIG.VALID_MIME_TYPES.items():
                if header.startswith(magic):
                    return True
            return False
        except Exception:
            return False

    @staticmethod
    def sanitize_path(path: str) -> str:
        """Prevent directory traversal."""
        return os.path.basename(path)

# -------------------------
# Forensic Mathematics
# -------------------------
class ForensicOps:
    """
    Mathematically rigorous feature extractors.
    """
    
    @staticmethod
    def calc_noise_stats(gray: np.ndarray) -> Tuple[float, float]:
        """
        Estimates noise variance using a robust median estimator.
        Returns: (noise_min_variance, noise_ratio)
        """
        # Noise estimation: Difference between image and its median filtered version
        # This isolates high-frequency stochastic noise from structural edges.
        denoised = cv2.medianBlur(gray, 3)
        noise_map = cv2.absdiff(gray, denoised)
        
        # Use variance of the residual
        var = float(np.var(noise_map))
        
        # Signal power
        signal_power = float(np.mean(gray ** 2))
        
        # Noise-to-Signal Ratio (inverse SNR roughly)
        ratio = var / (signal_power + 1e-9)
        return var, ratio

    @staticmethod
    def calc_freq_stats(gray: np.ndarray) -> Tuple[float, float]:
        """
        FFT analysis for periodic artifacts (Moiré/Resampling).
        Returns: (freq_max_magnitude, freq_energy_mean)
        """
        # Optimization: FFT on downsampled image is sufficient for major artifacts
        f = np.fft.fft2(gray.astype(float))
        fshift = np.fft.fftshift(f)
        
        # Mask DC component (Energy center) to find anomalous peaks
        h, w = gray.shape
        cy, cx = h // 2, w // 2
        mask_rad = 5
        fshift[cy-mask_rad:cy+mask_rad, cx-mask_rad:cx+mask_rad] = 0
        
        mag = np.abs(fshift)
        # Log scale not needed for raw stats, but magnitude helps find spikes
        return float(np.max(mag)), float(np.mean(mag))

    @staticmethod
    def calc_focus_stats(gray: np.ndarray) -> Tuple[float, float]:
        """
        Sharpness estimation via Laplacian Variance.
        Normalized by mean intensity to handle different lighting conditions.
        Returns: (focus_max_laplacian, focus_ratio)
        """
        lap = cv2.Laplacian(gray, cv2.CV_64F)
        
        # Normalization: Variance / Mean Intensity
        # prevents high-res bright images from artificially scoring high
        mean_intensity = np.mean(gray) + 1e-9
        var = np.var(lap)
        
        normalized_ratio = var / mean_intensity
        mx = np.max(np.abs(lap))
        return float(mx), float(normalized_ratio)

    @staticmethod
    def calc_clone_detection(img: np.ndarray) -> int:
        """
        Robust Copy-Move detection using ORB features.
        Fixes: Self-match filtering, Lowe's Ratio Test, Spatial Thresholding.
        """
        orb = cv2.ORB_create(nfeatures=500, fastThreshold=20)
        kp, des = orb.detectAndCompute(img, None)
        
        if des is None or len(kp) < 10:
            return 0
            
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(des, des, k=2) # Find 2 nearest neighbors
        
        valid_clones = []
        for m in matches:
            if len(m) == 2:
                m1, m2 = m
                # 1. Self-match check: Ignore if query == train
                if m1.queryIdx == m1.trainIdx:
                    continue
                
                # 2. Lowe's Ratio Test: Ensure match is distinct
                if m1.distance < CONFIG.CLONE_RATIO_TEST * m2.distance:
                    # 3. Spatial Distance Check:
                    # Ignore texture repetitions (neighbors). Real clones are distant.
                    pt1 = np.array(kp[m1.queryIdx].pt)
                    pt2 = np.array(kp[m1.trainIdx].pt)
                    dist = np.linalg.norm(pt1 - pt2)
                    
                    if dist > CONFIG.CLONE_MIN_DISTANCE_PX:
                        valid_clones.append(m1)
                        
        return len(valid_clones)

    @staticmethod
    def calc_ghosting(gray: np.ndarray) -> float:
        """
        Ghosting detection via multi-compression residuals.
        Checks for variance delta rather than simple mean difference.
        """
        # Encode/Decode at two quality levels
        _, enc60 = cv2.imencode('.jpg', gray, [int(cv2.IMWRITE_JPEG_QUALITY), 60])
        _, enc90 = cv2.imencode('.jpg', gray, [int(cv2.IMWRITE_JPEG_QUALITY), 90])
        
        dec60 = cv2.imdecode(enc60, 0).astype(float)
        dec90 = cv2.imdecode(enc90, 0).astype(float)
        
        # Calculate residual map
        diff = np.abs(dec60 - dec90)
        
        # A high variance in the difference map suggests localized inconsistencies
        # typical of re-saved JPEGs with different Q-tables.
        return float(np.var(diff))

    @staticmethod
    def calc_ela(path: str) -> Tuple[float, float]:
        """
        Error Level Analysis.
        Multi-Level: Checks multiple qualities to ensure robustness.
        Returns: (max_avg_error, max_peak_error) across qualities.
        """
        max_avg = 0.0
        max_peak = 0.0
        
        try:
            with Image.open(path) as orig:
                orig = orig.convert("RGB")
                
                for q in CONFIG.ELA_QUALITY_STEPS:
                    buf = io.BytesIO()
                    orig.save(buf, "JPEG", quality=q)
                    buf.seek(0)
                    resaved = Image.open(buf).convert("RGB")
                    
                    ela_img = ImageChops.difference(orig, resaved)
                    ela_arr = np.asarray(ela_img)
                    
                    # Statistics
                    current_avg = float(np.mean(ela_arr))
                    extrema = ela_img.getextrema()
                    current_peak = float(max([ex[1] for ex in extrema]))
                    
                    if current_avg > max_avg:
                        max_avg = current_avg
                        max_peak = current_peak
                
                return max_avg, max_peak
        except Exception:
            return 0.0, 0.0

