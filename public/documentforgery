def safe_decode_image(path: str, flags: int = cv2.IMREAD_COLOR) -> Optional[np.ndarray]:
    """Robust image loader handling non-ascii paths if necessary."""
    try:
        # Check file size first
        if os.path.getsize(path) > MAX_FILE_SIZE_MB * 1024 * 1024:
            logger.warning(f"File exceeds {MAX_FILE_SIZE_MB}MB limit.")
            return None
        return cv2.imread(path, flags)
    except Exception:
        return None

# -------------------------
# Forensic Math Ops
# -------------------------
class ForensicOps:
    """
    Mathematically rigorous feature extractors aligned to Schema.
    """
    @staticmethod
    def calc_noise_stats(gray: np.ndarray) -> Tuple[float, float]:
        """Returns (noise_min_variance, noise_ratio)"""
        # Estimate noise via median filtering residuals
        denoised = cv2.medianBlur(gray, 3)
        noise_map = cv2.absdiff(gray, denoised)
        var = np.var(noise_map)
        # Ratio of noise energy to signal energy
        signal_energy = np.mean(gray ** 2)
        ratio = float(np.mean(noise_map ** 2) / (signal_energy + 1e-6))
        return float(var), float(ratio)

    @staticmethod
    def calc_freq_stats(gray: np.ndarray) -> Tuple[float, float]:
        """Returns (freq_max_magnitude, freq_energy_mean)"""
        f = np.fft.fft2(gray.astype(float))
        fshift = np.fft.fftshift(f)
        # Mask DC component (center)
        h, w = gray.shape
        cy, cx = h // 2, w // 2
        fshift[cy-2:cy+3, cx-2:cx+3] = 0
        mag = np.abs(fshift)
        return float(np.max(mag)), float(np.mean(mag))

    @staticmethod
    def calc_chroma_stats(img: np.ndarray) -> Tuple[float, float]:
        """Returns (chroma_mean_diff, chroma_std_diff)"""
        yuv = cv2.cvtColor(img, cv2.COLOR_BGR2YUV)
        # U vs V difference
        u = yuv[:, :, 1].astype(float)
        v = yuv[:, :, 2].astype(float)
        diff = np.abs(u - v)
        return float(np.mean(diff)), float(np.std(diff))

    @staticmethod
    def calc_focus_stats(gray: np.ndarray) -> Tuple[float, float]:
        """Returns (focus_max_laplacian, focus_ratio)"""
        lap = cv2.Laplacian(gray, cv2.CV_64F)
        var = np.var(lap)
        mx = np.max(np.abs(lap))
        return float(mx), float(var)

    @staticmethod
    def calc_texture_stats(gray: np.ndarray) -> Tuple[float, float]:
        """Returns (texture_contrast_mean, texture_anomaly_score)"""
        # Contrast: Standard deviation of local blocks can be approximated by global std
        contrast = float(np.std(gray))
        
        # Anomaly: Use SRM residual (Spam1) variance as a texture anomaly proxy
        kernel = np.array([[0, 0, 0], [1, -1, 0], [0, 0, 0]], dtype=float)
        res = cv2.filter2D(gray.astype(float), -1, kernel)
        anomaly = float(np.var(res))
        return contrast, anomaly

    @staticmethod
    def calc_edge_stats(gray: np.ndarray) -> Tuple[float, float]:
        """Returns (edge_cardinality_ratio, edge_mean_strength)"""
        # Cardinality: Ratio of edge pixels to total pixels (Canny)
        edges = cv2.Canny(gray, 100, 200)
        cardinality = float(np.count_nonzero(edges) / edges.size)
        
        # Strength: Sobel magnitude mean
        sx = cv2.Sobel(gray, cv2.CV_64F, 1, 0)
        sy = cv2.Sobel(gray, cv2.CV_64F, 0, 1)
        mag = np.sqrt(sx**2 + sy**2)
        strength = float(np.mean(mag))
        return cardinality, strength

