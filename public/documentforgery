def worker_metadata(original_path: str, temp_path: str) -> Tuple[Dict, List[str], Optional[str]]:
    logs = []
    try:
        # Open original file for metadata (processing strips it)
        with open(original_path, 'rb') as f:
            tags = exifread.process_file(f, details=False)
        
        sw = str(tags.get("Image Software", "")).lower()
        has_sw = 1 if any(x in sw for x in ("adobe", "photoshop", "gimp", "paint")) else 0
        
        # Robust Date check (logic simplified for single file)
        has_date_mismatch = 0 
        
        feats = {
            "meta_has_editing_software": has_sw,
            "meta_tag_count": int(len(tags)),
            "meta_date_mismatch": has_date_mismatch,
        }
        logs.append(f"Metadata Tags Found: {len(tags)}")
        return feats, logs, None
    except Exception as e:
        return {}, logs, f"Metadata Failed: {str(e)}"

def worker_pixel_stats(original_path: str, temp_path: str) -> Tuple[Dict, List[str], Optional[str]]:
    logs = []
    try:
        # Load from temp path (pre-processed)
        img = cv2.imread(temp_path, cv2.IMREAD_COLOR)
        if img is None: raise ValueError("Worker could not read image")
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

        n_var, n_rat = ForensicOps.calc_noise_stats(gray)
        f_max, f_eng = ForensicOps.calc_freq_stats(gray)
        
        # Chroma
        yuv = cv2.cvtColor(img, cv2.COLOR_BGR2YUV)
        u, v = yuv[:, :, 1].astype(float), yuv[:, :, 2].astype(float)
        c_diff = np.abs(u - v)
        c_mean, c_std = float(np.mean(c_diff)), float(np.std(c_diff))
        
        foc_max, foc_rat = ForensicOps.calc_focus_stats(gray)
        
        # Texture & Edge
        tex_con = float(np.std(gray))
        # Simple high-pass for texture anomaly
        res = cv2.Laplacian(gray, cv2.CV_64F)
        tex_anom = float(np.var(res))
        
        edges = cv2.Canny(gray, 100, 200)
        edge_card = float(np.count_nonzero(edges) / edges.size)
        
        sx = cv2.Sobel(gray, cv2.CV_64F, 1, 0)
        sy = cv2.Sobel(gray, cv2.CV_64F, 0, 1)
        edge_str = float(np.mean(np.sqrt(sx**2 + sy**2)))

        feats = {
            "noise_min_variance": n_var, "noise_ratio": n_rat,
            "freq_max_magnitude": f_max, "freq_energy_mean": f_eng,
            "chroma_mean_diff": c_mean, "chroma_std_diff": c_std,
            "focus_max_laplacian": foc_max, "focus_ratio": foc_rat,
            "texture_contrast_mean": tex_con, "texture_anomaly_score": tex_anom,
            "edge_cardinality_ratio": edge_card, "edge_mean_strength": edge_str
        }
        return feats, logs, None
    except Exception as e:
        return {}, logs, f"PixelStats Failed: {str(e)}"

def worker_heavy_ops(original_path: str, temp_path: str) -> Tuple[Dict, List[str], Optional[str]]:
    logs = []
    try:
        # ELA uses PIL, needs path
        ela_avg, ela_max = ForensicOps.calc_ela(temp_path)
        
        # Load for CV2 ops
        img = cv2.imread(temp_path, cv2.IMREAD_COLOR)
        if img is None: raise ValueError("Worker could not read image")
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        
        ghost_val = ForensicOps.calc_ghosting(gray)
        clone_count = ForensicOps.calc_clone_detection(img)
        
        feats = {
            "ela_average_error": ela_avg,
            "ela_max_error": ela_max,
            "ghost_anomaly_score": ghost_val,
            "clone_keypoint_matches": clone_count
        }
        logs.append(f"Clones: {clone_count}, GhostScore: {ghost_val:.2f}")
        return feats, logs, None
    except Exception as e:
        return {}, logs, f"HeavyOps Failed: {str(e)}"

# -------------------------
# Main Engine
# -------------------------
class ForensicsEngine:
    def __init__(self, target_file: str = CONFIG.TARGET_FILE):
        self.target_file = target_file
        self.temp_dir = tempfile.mkdtemp(prefix="forensics_secure_")
        self.model = self._load_model()
        
    def _load_model(self):
        if XGB_AVAILABLE and os.path.exists(CONFIG.MODEL_FILE):
            try:
                model = xgb.XGBClassifier()
                model.load_model(CONFIG.MODEL_FILE)
                return model
            except Exception:
                return None
        return None

    def __del__(self):
        # Atomic cleanup
        if os.path.exists(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)

    def preprocess(self) -> str:
        """
        Validates, resizes, and prepares image for workers.
        Returns path to processed temp file.
        """
        if not os.path.exists(self.target_file):
            raise FileNotFoundError(f"Input file not found: {self.target_file}")
            
        # Security: Magic Byte Check
        if not SecureIO.validate_image_header(self.target_file):
            raise ValueError("Invalid file format. Not a recognized image.")
            
        # Security: Size Check
        if os.path.getsize(self.target_file) > CONFIG.MAX_FILE_SIZE_MB * 1024 * 1024:
            raise ValueError(f"File exceeds limit of {CONFIG.MAX_FILE_SIZE_MB}MB")

        img = cv2.imread(self.target_file)
        if img is None:
            raise ValueError("CV2 failed to decode image structure.")
            
        h, w = img.shape[:2]
        processed_path = os.path.join(self.temp_dir, f"proc_{secrets.token_hex(4)}.png")
        
        # Grid-Aware Downsampling (preserve 8x8 blocks if possible for JPEG forensics)
        if max(h, w) > CONFIG.MAX_IMAGE_DIM:
            scale = CONFIG.MAX_IMAGE_DIM / max(h, w)
            # Ensure new dimensions are divisible by 8 for better JPEG artifact analysis alignment
            new_w = int(w * scale) // 8 * 8
            new_h = int(h * scale) // 8 * 8
            new_w = max(8, new_w)
            new_h = max(8, new_h)
            
            img_resized = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_AREA)
            cv2.imwrite(processed_path, img_resized)
        else:
            cv2.imwrite(processed_path, img)
            
        return processed_path

    def calculate_risk(self, vec: Dict[str, Any]) -> Dict[str, Any]:
        """Hybrid Risk Scoring."""
        score = 0.0
        ml_prob = 0.0
        flags = []
        
        # 1. ML Inference
        if self.model:
            try:
                # Sanitized input vector (handle NaN/Inf)
                input_vec = []
                for k in ML_SCHEMA:
                    if k in ['filename', 'timestamp']: continue
                    val = vec.get(k, 0.0)
                    if math.isnan(val) or math.isinf(val): val = 0.0
                    input_vec.append(val)
                
                # Predict (assuming model expects strict schema order)
                # Note: In production, DataFrame with named cols is safer, 
                # but stripped here for dependency minimization if pandas not present
                import pandas as pd
                df = pd.DataFrame([dict(zip([k for k in ML_SCHEMA if k not in ['filename', 'timestamp']], input_vec))])
                
                # Handle Feature alignment if possible
                if hasattr(self.model, 'feature_names_in_'):
                    # Align df to model features, fill 0
                    df = df.reindex(columns=self.model.feature_names_in_, fill_value=0)

                ml_prob = float(self.model.predict_proba(df)[0][1])
                score = ml_prob * 100
            except Exception as e:
                logger.warning(f"ML Inference skipped: {e}")

        # 2. Heuristics (Aggressively Tuned)
        # Visual
        if vec.get("clone_keypoint_matches", 0) > 0: # Strict
            score += 40
            flags.append(f"Visual: Cloning Detected ({vec.get('clone_keypoint_matches')} matches)")

        # ELA: Check relative intensity
        ela_avg = vec.get("ela_average_error", 0)
        ela_max = vec.get("ela_max_error", 0)
        if ela_avg > 0.5 and (ela_max / (ela_avg + 1e-6)) > 15:
            score += 20
            flags.append("Visual: Localized Compression Artifacts")

        # Ghosting
        if vec.get("ghost_anomaly_score", 0) > 5.0: # Tuned threshold for high variance
            score += 20
            flags.append("Visual: Ghosting Artifacts")

        # Texture Anomaly (Massive spike detection)
        if vec.get("texture_anomaly_score", 0) > 500.0:
            score += 20
            flags.append("Visual: High Texture Anomaly (Splicing)")

        # Noise Variance (Inconsistency detection)
        if vec.get("noise_min_variance", 0) > 25.0:
            score += 10
            flags.append("Visual: High Noise Variance")

        # Metadata
        if vec.get("meta_has_editing_software", 0) == 1:
            score += 30
            flags.append("Metadata: Editing Software")

        final_score = min(100, max(0, int(score)))
        level = "Critical" if final_score > 85 else ("High" if final_score > 60 else ("Medium" if final_score > 30 else "Low"))

        return {
            "risk_score": final_score,
            "risk_level": level,
            "ml_probability": ml_prob,
            "flagged_factors": flags
        }

    def save_results(self, features: Dict[str, Any]) -> None:
        """Sanitized CSV Append."""
        row = {k: features.get(k, 0) for k in ML_SCHEMA}
        
        # Sanitize floats
        for k, v in row.items():
            if isinstance(v, float):
                if math.isnan(v) or math.isinf(v):
                    row[k] = 0.0
                    
        file_exists = os.path.exists(CONFIG.ML_CSV_FILE) and os.path.getsize(CONFIG.ML_CSV_FILE) > 0
        try:
            with open(CONFIG.ML_CSV_FILE, "a", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=ML_SCHEMA, extrasaction='ignore')
                if not file_exists:
                    writer.writeheader()
                writer.writerow(row)
        except Exception as e:
            logger.error(f"CSV Write Failed: {e}")

    def run(self):
        t0 = time.time()
        result_data = {}
        
        try:
            # 1. Secure Preprocessing
            proc_path = self.preprocess()
            
            # 2. Parallel Workers
            workers = [
                (worker_metadata, "Metadata"),
                (worker_pixel_stats, "PixelStats"),
                (worker_heavy_ops, "HeavyOps")
            ]
            
            features = {}
            # Defaults for Schema
            for k in ML_SCHEMA: 
                if k not in ["filename", "timestamp"]: features[k] = 0.0

            with concurrent.futures.ProcessPoolExecutor() as executor:
                # Pass paths, not bytes
                future_map = {
                    executor.submit(func, self.target_file, proc_path): label 
                    for func, label in workers
                }
                
                for fut in concurrent.futures.as_completed(future_map):
                    label = future_map[fut]
                    try:
                        w_feats, w_logs, w_err = fut.result()
                        if w_err:
                            logger.error(f"Worker {label} Error: {w_err}")
                        else:
                            features.update(w_feats)
                            for log in w_logs: logger.info(f"[{label}] {log}")
                    except Exception as e:
                        logger.error(f"Worker {label} Crash: {e}")

            # 3. Finalize
            features["filename"] = SecureIO.sanitize_path(self.target_file)
            features["timestamp"] = time.ctime()
            
            self.save_results(features)
            risk = self.calculate_risk(features)
            
            result_data = {
                "version": "3.1.0",
                "time_sec": time.time() - t0,
                "risk": risk,
                "features": features
            }
            
            print(json.dumps(result_data, indent=2, cls=NumpyEncoder))
            
            # Atomic Report Write
            safe_makedirs(CONFIG.STORAGE_DIR)
            report_name = f"report_{secrets.token_hex(4)}.json"
            with open(os.path.join(CONFIG.STORAGE_DIR, report_name), "w") as f:
                json.dump(result_data, f, indent=2, cls=NumpyEncoder)

        except Exception as e:
            logger.critical(f"Engine Failure: {e}")
            print(json.dumps({"error": str(e), "risk": {"risk_level": "Unknown"}}))

