    parser = argparse.ArgumentParser(description="ForensicsEngine v3.1.0")
    parser.add_argument("--input", "-i", default=CONFIG.TARGET_FILE, help="Path to image file")
    
    # Jupyter/Colab Compatibility Fix:
    # Use parse_known_args() to safely ignore Jupyter kernel arguments (like -f kernel.json)
    args, _ = parser.parse_known_args()
    
    engine = ForensicsEngine(target_file=args.input)
    engine.run()

