def worker_metadata(original_path: str, temp_path: str, outdir: str) -> Dict[str, Any]:
    """Reads EXIF from ORIGINAL file (before downsampling strips it)."""
    try:
        with open(original_path, 'rb') as f:
            tags = exifread.process_file(f, details=False)
        
        sw = str(tags.get("Image Software", "")).lower()
        has_sw = 1 if any(x in sw for x in ("adobe", "photoshop", "gimp", "paint")) else 0
        
        feats = {
            "meta_has_editing_software": has_sw,
            "meta_tag_count": int(len(tags)),
            "meta_date_mismatch": 0, # Placeholder for complex date logic
        }
        return {"service": "Metadata", "features": feats, "summary": f"Tags: {len(tags)}"}
    except Exception as e:
        logger.error(f"Metadata error: {e}")
        # Return defaults if failed
        return {"service": "Metadata", "features": {"meta_has_editing_software": 0, "meta_tag_count": 0, "meta_date_mismatch": 0}, "error": str(e)}

def worker_pixel_stats(original_path: str, temp_path: str, outdir: str) -> Dict[str, Any]:
    """Calculates all pixel-domain statistics required by the CSV schema."""
    cv2.setNumThreads(0) # Prevent OpenCV threading inside process
    try:
        # Read from PRE-PROCESSED temp file (Fast)
        img = cv2.imread(temp_path, cv2.IMREAD_COLOR)
        if img is None: raise ValueError("Image load failed")
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

        n_var, n_rat = ForensicOps.calc_noise_stats(gray)
        f_max, f_eng = ForensicOps.calc_freq_stats(gray)
        c_mean, c_std = ForensicOps.calc_chroma_stats(img)
        foc_max, foc_rat = ForensicOps.calc_focus_stats(gray)
        tex_con, tex_anom = ForensicOps.calc_texture_stats(gray)
        edge_card, edge_str = ForensicOps.calc_edge_stats(gray)

        feats = {
            "noise_min_variance": n_var, "noise_ratio": n_rat,
            "freq_max_magnitude": f_max, "freq_energy_mean": f_eng,
            "chroma_mean_diff": c_mean, "chroma_std_diff": c_std,
            "focus_max_laplacian": foc_max, "focus_ratio": foc_rat,
            "texture_contrast_mean": tex_con, "texture_anomaly_score": tex_anom,
            "edge_cardinality_ratio": edge_card, "edge_mean_strength": edge_str
        }
        return {"service": "PixelStats", "features": feats, "summary": "Pixel stats computed"}
    except Exception as e:
        logger.error(f"PixelStats error: {e}")
        return {"service": "PixelStats", "features": {}, "error": str(e)}

def worker_heavy_ops(original_path: str, temp_path: str, outdir: str) -> Dict[str, Any]:
    """Handles ELA, Ghosting, and Cloning. Computationally expensive."""
    cv2.setNumThreads(0)
    try:
        # 1. ELA (Error Level Analysis)
        # Logic: Save at known quality, check difference.
        # Use PIL for ELA as it handles JPEG tables explicitly
        try:
            with Image.open(temp_path) as orig:
                orig = orig.convert("RGB")
                buf = io.BytesIO()
                orig.save(buf, "JPEG", quality=90)
                buf.seek(0)
                resaved = Image.open(buf).convert("RGB")
                ela_img = ImageChops.difference(orig, resaved)
                # Extrema gives (min, max) for R, G, B
                extrema = ela_img.getextrema()
                max_diff = max([ex[1] for ex in extrema])
                
                # Calculate average error
                ela_arr = np.asarray(ela_img)
                avg_error = float(np.mean(ela_arr))
        except Exception:
            avg_error = 0.0
            max_diff = 0.0

        img = cv2.imread(temp_path, cv2.IMREAD_COLOR)
        if img is None: raise ValueError("Image load failed")

        # 2. Ghosting (Double Compression Artifacts)
        # Check difference between quality 60 vs 90 recompressions
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        _, enc60 = cv2.imencode('.jpg', gray, [int(cv2.IMWRITE_JPEG_QUALITY), 60])
        _, enc90 = cv2.imencode('.jpg', gray, [int(cv2.IMWRITE_JPEG_QUALITY), 90])
        dec60 = cv2.imdecode(enc60, 0).astype(float)
        dec90 = cv2.imdecode(enc90, 0).astype(float)
        # Normalized difference
        ghost_diff = np.mean(np.abs(dec60 - dec90))
        
        # 3. Clone Detection (Keypoints with Spatial Filtering)
        # INCREASED FEATURES for higher sensitivity
        orb = cv2.ORB_create(nfeatures=1000)
        kp, des = orb.detectAndCompute(img, None)
        clone_matches = 0
        if des is not None and len(kp) > 5:
            bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
            matches = bf.knnMatch(des, des, k=2)
            valid_clones = []
            for m in matches:
                if len(m) == 2:
                    m1, m2 = m
                    # Ratio test
                    if m1.queryIdx != m1.trainIdx and m1.distance < 0.75 * m2.distance:
                        # Spatial check: Keypoints must be > 10px apart to be "cloned"
                        # otherwise it's just recurring texture
                        pt1 = np.array(kp[m1.queryIdx].pt)
                        pt2 = np.array(kp[m1.trainIdx].pt)
                        dist = np.linalg.norm(pt1 - pt2)
                        if dist > 15:
                            valid_clones.append(m1)
            clone_matches = len(valid_clones)

        feats = {
            "ela_average_error": avg_error,
            "ela_max_error": float(max_diff),
            "ghost_anomaly_score": float(ghost_diff), # Replaces raw variance
            "clone_keypoint_matches": clone_matches
        }
        return {"service": "HeavyOps", "features": feats, "summary": f"Clones: {clone_matches}, Ghost: {ghost_diff:.2f}"}
    except Exception as e:
        logger.error(f"HeavyOps error: {e}")
        return {"service": "HeavyOps", "features": {}, "error": str(e)}

# -------------------------
# Orchestrator
# -------------------------
class ForensicsEngine:
    def __init__(self, target_file: str = TARGET_FILE, storage_dir: str = STORAGE_DIR, max_workers: Optional[int] = None, verbose: bool = VERBOSE_RUNTIME):
        self.target_file = target_file
        self.storage_dir = storage_dir
        safe_makedirs(self.storage_dir)
        self.max_workers = max_workers or DEFAULT_MAX_WORKERS
        self.verbose = verbose
        self.temp_dir = tempfile.mkdtemp(prefix="forensics_")
        
        # Load ML Model
        self.model = None
        if XGB_AVAILABLE and os.path.exists(MODEL_FILE):
            try:
                self.model = xgb.XGBClassifier()
                self.model.load_model(MODEL_FILE)
                if self.verbose: logger.info("ML Model Loaded.")
            except Exception as e:
                logger.error(f"Model load failed: {e}")

    def __del__(self):
        # Cleanup temp dir on exit
        if os.path.exists(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)

    def preprocess_input(self) -> Tuple[str, str]:
        """
        1. Decodes input (Base64 or File).
        2. Validates size/dimensions.
        3. Downsamples if necessary.
        4. Saves to temp file.
        Returns: (original_path, temp_processed_path)
        """
        # 1. Handle Input Source
        original_path = self.target_file
        
        # If input is text/base64, decode to temp file first
        if self.target_file.endswith('.txt') or not os.path.exists(self.target_file):
            if os.path.exists(self.target_file):
                with open(self.target_file, 'r') as f:
                    content = f.read().strip()
            else:
                # Assuming dummy generation for testing
                content = "" # Handle appropriately or raise
            
            # Simple heuristic for Base64
            if "," in content: content = content.split(",")[-1]
            
            try:
                raw_data = base64.b64decode(content)
                original_path = os.path.join(self.temp_dir, "decoded_original.jpg")
                with open(original_path, "wb") as f:
                    f.write(raw_data)
            except Exception:
                # If decode fails or file missing, create dummy for robustness
                logger.warning("Input missing or invalid. Using dummy.")
                original_path = os.path.join(self.temp_dir, "dummy.jpg")
                dummy = np.zeros((500,500,3), dtype=np.uint8)
                cv2.imwrite(original_path, dummy)

        # 2. Decode & Downsample
        img = cv2.imread(original_path)
        if img is None:
            raise ValueError("Failed to decode image file")

        h, w = img.shape[:2]
        processed_path = os.path.join(self.temp_dir, "processed_input.png") # PNG for lossless after resize

        if max(h, w) > MAX_IMAGE_DIM:
            scale = MAX_IMAGE_DIM / max(h, w)
            new_w, new_h = int(w * scale), int(h * scale)
            if self.verbose: logger.info(f"Downsampling image from {w}x{h} to {new_w}x{new_h}")
            img_resized = cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_AREA)
            cv2.imwrite(processed_path, img_resized)
        else:
            cv2.imwrite(processed_path, img)

        return original_path, processed_path

    def calculate_risk(self, vec: Dict[str, Any]) -> Dict[str, Any]:
        """Hybrid Risk Scoring with Enhanced Heuristics."""
        score = 0.0
        ml_prob = 0.0
        flags = []
        
        # 1. ML Inference
        if self.model:
            try:
                import pandas as pd
                # Ensure DataFrame columns match training exactly
                df = pd.DataFrame([vec])
                # Filter to Schema columns
                # Only use columns that exist in the vec and are in the schema
                df_clean = pd.DataFrame([{k: vec.get(k, 0) for k in ML_SCHEMA if k not in ['filename', 'timestamp']}])
                
                # Check feature names if available to align
                if hasattr(self.model, 'feature_names_in_'):
                    df_clean = df_clean.reindex(columns=self.model.feature_names_in_, fill_value=0)

                ml_prob = float(self.model.predict_proba(df_clean)[0][1])
                score = ml_prob * 100
            except Exception as e:
                logger.warning(f"Inference warning: {e}")

        # 2. Heuristics (Boost)
        visual_flags = 0
        
        # A. Metadata (Base suspicion)
        if vec.get("meta_has_editing_software", 0) == 1:
            score += 25
            flags.append("Metadata: Editing Software")
        
        # B. Visual Anomalies
        
        # Clone Detection (High confidence)
        if vec.get("clone_keypoint_matches", 0) > 3: # Lower threshold, 8 was too high
            score += 40
            visual_flags += 1
            flags.append(f"Visual: Cloning Detected ({vec.get('clone_keypoint_matches')} matches)")

        # ELA (Compression Anomalies)
        ela_avg = vec.get("ela_average_error", 0)
        ela_max = vec.get("ela_max_error", 0)
        
        # REFINED: ELA check logic
        # Legitimate docs with text often have a high ratio but LOW absolute intensity (e.g., max 18).
        # We require a 'substantial' artifact (max > 30) AND a high ratio to flag.
        if ela_avg > 0.5 and (ela_max / ela_avg) > 15 and ela_max > 30: 
            score += 20
            visual_flags += 1
            flags.append("Visual: Localized Compression Artifacts (ELA)")
        elif ela_avg > 4: # High global error (very noisy/recompressed)
            score += 15
            visual_flags += 1
            flags.append("Visual: High Global Compression Error")

        # Ghosting (Resave artifacts)
        # Thresholding > 2.0 catch subtle resaves.
        if vec.get("ghost_anomaly_score", 0) > 2.0:
            score += 15
            visual_flags += 1
            flags.append("Visual: Ghosting/Resave Artifacts")
            
        # Texture Anomalies (Splicing/Smoothing)
        if vec.get("texture_anomaly_score", 0) > 120:
            score += 15
            visual_flags += 1
            flags.append("Visual: High Texture Anomaly (Potential Splicing)")
            
        # Unnatural Sharpness (Digital Splicing / Sharpening)
        # Real camera images usually have focus_ratio < 200. Digital inserts often spike this.
        if vec.get("focus_ratio", 0) > 600:
            score += 20
            visual_flags += 1
            flags.append("Visual: Unnatural Sharpness/Edges")

        # Inconsistent Noise (Digital Denoising / Inserts)
        if vec.get("noise_min_variance", 0) > 30:
             score += 10
             visual_flags += 1
             flags.append("Visual: High Noise Variance")

        # C. Correlation Bonus
        # If we have both Metadata AND Visual anomalies, probability of fraud skyrockets.
        if vec.get("meta_has_editing_software", 0) == 1 and visual_flags > 0:
            score += 20
            flags.append("Correlation: Edited Metadata + Visual Anomalies")

        final_score = min(100, max(0, int(score)))
        level = "Critical" if final_score > 85 else ("High" if final_score > 60 else ("Medium" if final_score > 30 else "Low"))

        return {
            "risk_score": final_score,
            "risk_level": level,
            "ml_probability": ml_prob,
            "flagged_factors": flags
        }

    def run(self) -> None:
        t0 = time.time()
        
        try:
            # 1. Preprocess (Decode once, Resize, Save Temp)
            orig_path, proc_path = self.preprocess_input()
            
            # 2. Define Workers
            # Workers take paths, not bytes -> Efficient IPC
            workers = [
                (worker_metadata, "Metadata"),
                (worker_pixel_stats, "PixelStats"),
                (worker_heavy_ops, "HeavyOps")
            ]
            
            features: Dict[str, Any] = {}
            
            # 3. Execute
            with concurrent.futures.ProcessPoolExecutor(max_workers=self.max_workers) as ex:
                # Submit paths
                future_map = {ex.submit(func, orig_path, proc_path, self.storage_dir): label for func, label in workers}
                
                for fut in concurrent.futures.as_completed(future_map):
                    label = future_map[fut]
                    try:
                        res = fut.result()
                        features.update(res.get("features", {}))
                        if self.verbose: print(f"[+] {label} complete.")
                    except Exception as e:
                        logger.error(f"Worker {label} crashed: {e}")
            
            # 4. Finalize
            features["filename"] = os.path.basename(self.target_file)
            features["timestamp"] = time.ctime()
            
            # Save Training Vector
            self.write_csv(features)
            
            # Calculate Risk
            risk = self.calculate_risk(features)
            
            # Output
            elapsed = time.time() - t0
            result_json = {
                "version": "2.3.0",
                "analysis_time_sec": elapsed,
                "risk": risk,
                "features": features
            }
            
            print(json.dumps(result_json, indent=2, cls=NumpyEncoder))
            
            # Save Report
            report_path = os.path.join(self.storage_dir, f"report_{int(time.time())}.json")
            with open(report_path, "w") as f:
                json.dump(result_json, f, indent=2, cls=NumpyEncoder)

        except Exception as e:
            logger.error(f"Engine Validation Failed: {e}")
            print(json.dumps({"error": str(e)}))
        finally:
            # Explicit cleanup
            if os.path.exists(self.temp_dir):
                shutil.rmtree(self.temp_dir, ignore_errors=True)

    def write_csv(self, features: Dict[str, Any]) -> None:
        """Appends to CSV with strict schema filtering."""
        row = {k: features.get(k, 0) for k in ML_SCHEMA}
        # Special handling for strings in numeric cols if any (sanitization)
        
        file_exists = os.path.exists(ML_CSV_FILE) and os.path.getsize(ML_CSV_FILE) > 0
        try:
            with open(ML_CSV_FILE, "a", newline="") as f:
                writer = csv.DictWriter(f, fieldnames=ML_SCHEMA, extrasaction='ignore')
                if not file_exists:
                    writer.writeheader()
                writer.writerow(row)
        except Exception as e:
            logger.error(f"CSV write error: {e}")

