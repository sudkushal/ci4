if __name__ == "__main__":
    print("\n" + "="*50)
    print("🤖 ENTERPRISE SALES AGENT (Interactive Mode)")
    print("   Type 'exit' to quit.")
    print("="*50 + "\n")
    
    agent = AgentOrchestrator()
    
    # State tracking
    accumulated_context = ""
    MAX_ATTEMPTS = 10
    attempts = 0
    
    while True:
        # 1. Get Input
        if attempts == 0:
            user_input = input("👤 ENTER REQUEST (e.g. Paste Transcript): ").strip()
        else:
            user_input = input(f"👤 CLARIFY ({attempts}/{MAX_ATTEMPTS}): ").strip()
            
        if user_input.lower() in ['exit', 'quit']:
            print("👋 Exiting.")
            break
            
        if not user_input: continue

        # 2. Accumulate Context (Append to history)
        if accumulated_context:
            accumulated_context += " " + user_input
        else:
            accumulated_context = user_input
            
        attempts += 1
        
        # 3. Safety Break
        if attempts > MAX_ATTEMPTS:
            print("\n❌ MAX ATTEMPTS REACHED. Resetting session.")
            accumulated_context = ""
            attempts = 0
            continue

        print("   Thinking...", end="\r")
        
        # 4. Call API
        response = agent.process_request(accumulated_context)
        
        # 5. Handle Response
        if response["status"] == "SUCCESS":
            print("\n" + "✅ ANALYSIS COMPLETE ".center(50, "="))
            print(response["report"])
            print("="*50)
            print(f"📊 DEBUG: Score={response['data']['score']}% | Bundle={response['data']['bundle']}")
            print("\n--- Session Reset ---\n")
            accumulated_context = ""
            attempts = 0
            
        elif response["status"] == "NEEDS_INFO":
            print("\n🛑 AGENT NEEDS INFO:")
            for q in response["questions"]:
                print(f"   ❓ {q}")
            print()
            
        else:
            print(f"\n⚠️ SYSTEM: {response.get('message')}")
            accumulated_context = ""
            attempts = 0
