# 4. SERVICES LAYER (Security & AI)
# ==========================================
class SecurityService:
    @staticmethod
    def redact_pii(text: str) -> str:
        """
        Regex Scrubber. Retains Company Names (Context) but removes direct PII.
        """
        if not text: return ""
        # Redact Email
        text = re.sub(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b', "[EMAIL_REDACTED]", text)
        # Redact Phone
        text = re.sub(r'\b(?:\+?(\d{1,3}))?[-. (]*(\d{3})[-. )]*(\d{3})[-. ]*(\d{4})\b', "[PHONE_REDACTED]", text)
        return text

class LLMService:
    def __init__(self):
        try:
            vertexai.init(project=PROJECT_ID, location=LOCATION)
            self.model = GenerativeModel("gemini-1.5-flash-001")
        except Exception:
            self.model = None
            print("⚠️ WARNING: Vertex AI Init Failed. Check GCP Credentials.")

    @retry(stop=stop_after_attempt(3), wait=wait_fixed(1))
    def generate_json(self, prompt: str) -> Dict[str, Any]:
        if not self.model: return {}
        config = GenerationConfig(response_mime_type="application/json", temperature=0.0)
        try:
            response = self.model.generate_content(prompt, generation_config=config)
            clean = re.sub(r"```json|```", "", response.text).strip()
            return json.loads(clean)
        except:
            return {}

    def generate_text(self, prompt: str) -> str:
        if not self.model: return "LLM Offline"
        config = GenerationConfig(temperature=0.3)
        return self.model.generate_content(prompt, generation_config=config).text

# ==========================================
# 5. VALIDATOR SERVICE (The Gatekeeper)
# ==========================================
class ValidatorService:
    def __init__(self, llm: LLMService):
        self.llm = llm

    def validate(self, text: str) -> List[str]:
        # 1. Heuristic Check
        if len(text) < 10:
            return ["Input is too short. Please describe the Industry and the Problem."]
            
        # 2. Semantic Check
        prompt = f"""
        Role: Sales Gatekeeper.
        Task: Check input for TWO things:
        1. Context (Industry/Client Type)
        2. Technical Pain Point (The Problem)
        
        Input: "{text}"
        
        Output JSON: {{ "status": "GO" }} OR {{ "status": "STOP", "questions": ["Clarifying Question"] }}
        """
        data = self.llm.generate_json(prompt)
        
        if data.get("status") == "STOP":
            return data.get("questions", ["Please provide more details regarding the client industry and problem."])
        return []

# ==========================================
# 6. LOGIC ENGINE (The Math)
# ==========================================
@dataclass
class OrchestrationResult:
    bundle: List[Product]
    covered: Set[Any]
    missing: Set[str]
    score: int

class LogicEngine:
    @staticmethod
    def solve(reqs: List[str]) -> OrchestrationResult:
        # 1. Normalize
        valid_needs, missing_needs = set(), set()
        for r in reqs:
            enum_val = ontology.validate_req(r)
            if enum_val: valid_needs.add(enum_val)
            else: missing_needs.add(r) # It's a gap!

        # 2. Greedy Set Cover
        remaining = valid_needs.copy()
        bundle, covered = [], set()
        
        while remaining:
            best_prod, best_overlap = None, set()
            for prod in ontology.products:
                overlap = prod.capabilities.intersection(remaining)
                if len(overlap) > len(best_overlap):
                    best_overlap = overlap
                    best_prod = prod
            
            if best_prod:
                bundle.append(best_prod)
                remaining -= best_overlap
                covered.update(best_overlap)
            else:
                break
        
        # 3. Score
        score = int((len(covered) / len(reqs)) * 100) if reqs else 0
        missing_needs.update({r.value for r in remaining})
        return OrchestrationResult(bundle, covered, missing_needs, score)

# ==========================================
# 7. ORCHESTRATOR (Stateless API)
# ==========================================
class AgentOrchestrator:
    def __init__(self):
        self.llm = LLMService()
        self.security = SecurityService()
        self.logic = LogicEngine()
        self.validator = ValidatorService(self.llm)

    def process_request(self, user_text: str) -> Dict[str, Any]:
        # 1. Scrub
        clean_text = self.security.redact_pii(user_text)
        
        # 2. Validate (Stop here if info missing)
        questions = self.validator.validate(clean_text)
        if questions:
            return {"status": "NEEDS_INFO", "questions": questions}
            
        # 3. Extract Requirements
        prompt = f"""
        Extract technical requirements as JSON list.
        Text: "{clean_text}"
        Allowed Tags: {ontology.get_valid_tags()}
        Output: {{ "requirements": ["tag1", "tag2"] }}
        """
        data = self.llm.generate_json(prompt)
        reqs = data.get("requirements", [])
        
        if not reqs:
            return {"status": "NO_REQS", "message": "No technical needs detected."}

        # 4. Solve (Math)
        res = self.logic.solve(reqs)

        # 5. Report (Generation)
        report = self._generate_brief(res, reqs, clean_text)
        return {
            "status": "SUCCESS", 
            "report": report, 
            "data": {"score": res.score, "bundle": [p.name for p in res.bundle]}
        }

    def _generate_brief(self, res, reqs, context):
        bundle_txt = "\n".join([f"- **{p.name}**" for p in res.bundle])
        missing_txt = ", ".join(res.missing) if res.missing else "None"
        
        if res.score == 0: strat = "NO SOLUTION. Recommend No Bid."
        elif res.score < 100: strat = f"PARTIAL ({res.score}%). Highlight GAPS."
        else: strat = "PERFECT FIT."

        prompt = f"""
        Role: Principal Architect.
        Context: "{context}"
        Reqs: {reqs}
        Score: {res.score}%
        Gaps: {missing_txt}
        Bundle: {bundle_txt}
        Instruction: {strat}
        Write professional Markdown brief.
        """
        return self.llm.generate_text(prompt)

