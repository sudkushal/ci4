# ==========================================
# 3. DYNAMIC ONTOLOGY (Zero-Hardcoding)
# ==========================================
class Product(BaseModel):
    id: str
    name: str
    capabilities: Set[Any] # Will be Dynamic Enum members
    description: str

class OntologyEngine:
    def __init__(self):
        self.products: List[Product] = []
        self.CapabilityEnum = None
        self._refresh_schema()

    def _refresh_schema(self):
        raw_data = DatabaseAdapter.fetch_live_catalog()
        
        # 1. Discover all unique capabilities from DB
        all_caps = set()
        for item in raw_data:
            for cap in item['capabilities']:
                all_caps.add(cap)
        
        # 2. Create Dynamic Enum
        if not all_caps:
             self.CapabilityEnum = enum.Enum('Capability', {'NONE': 'none'})
        else:
            enum_map = {name.upper(): name for name in all_caps}
            self.CapabilityEnum = enum.Enum('Capability', enum_map)
        
        # 3. Hydrate Product Objects
        self.products = []
        for item in raw_data:
            valid_caps = set()
            for c_str in item['capabilities']:
                try:
                    valid_caps.add(self.CapabilityEnum(c_str))
                except ValueError:
                    pass
            self.products.append(Product(
                id=item['id'], name=item['name'], capabilities=valid_caps, description=item['description']
            ))

    def get_valid_tags(self) -> List[str]:
        return [e.value for e in self.CapabilityEnum] if self.CapabilityEnum else []

    def validate_req(self, req: str):
        try:
            return self.CapabilityEnum(req)
        except ValueError:
            return None

# Singleton (Loads once on startup)
ontology = OntologyEngine()

